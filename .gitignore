# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Generated data and experiment outputs
/runs/
/outputs/
/checkpoints/
*.pt
*.pth
*.ckpt
*.npz
*.npy

# Canonical Heston metadata is versioned. Full .npz datasets live directly under
# data/ for local runs, but remain ignored because several files exceed
# GitHub's 100MB/file limit.
!/data/
!/data/*.json

# Local logs and notebooks
*.log
.ipynb_checkpoints/

# OS/editor files
.DS_Store
.idea/
.vscode/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out

# Course report and presentation
/paper/
/presentation/

# Large bundled archives (local-only; extracted contents are committed where small)
*.tar
*.tgz

.claude/

# Archived material — superseded experiments, design drafts, scratch scripts,
# old runs/, server artifacts. Kept locally for reference, not part of the
# final deliverable (see archive/README.md).
/archive/

# Released model weights (release/checkpoints/*.pt) are too large for GitHub's
# 100MB/file limit, so they stay local-only and are delivered separately for
# the course submission. Their config.json/summary.json (and release/results/)
# remain tracked. The global *.pt rule above already ignores the weights.
# The packaged weight archive is distributed via 网盘; only its checksum is tracked.
/release/checkpoints.tar.gz
/release/data.tar.gz
